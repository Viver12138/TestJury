{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testjury.local/schemas/rubric.schema.json",
  "title": "TestJury Rubric",
  "type": "object",
  "required": ["version", "status", "dimensions", "severity", "categories", "voting", "conclusion_rules", "evidence"],
  "additionalProperties": false,
  "properties": {
    "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "status": { "enum": ["draft", "reviewed", "published", "deprecated"] },
    "dimensions": {
      "type": "object",
      "required": ["business", "test_design", "automation"],
      "additionalProperties": {
        "type": "object",
        "required": ["name", "owner", "checkpoints"],
        "properties": {
          "name": { "type": "string" },
          "owner": { "enum": ["chief", "jury_a", "jury_b"] },
          "prompt_weight": {
            "type": "object",
            "additionalProperties": { "type": "number", "minimum": 0 }
          },
          "checkpoints": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["id", "name"],
              "properties": {
                "id": { "type": "string" },
                "name": { "type": "string" }
              }
            }
          }
        }
      }
    },
    "severity": {
      "type": "object",
      "required": ["blocker", "major", "suggestion"],
      "additionalProperties": { "type": "string", "minLength": 1 }
    },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["dimensions"],
        "properties": {
          "dimensions": {
            "type": "array",
            "items": { "enum": ["business", "test_design", "automation"] }
          }
        }
      }
    },
    "scope": {
      "type": "object",
      "properties": {
        "v1_single_case_only": { "type": "boolean" },
        "coverage_claim_requires_full_scope": { "type": "boolean" }
      }
    },
    "voting": {
      "type": "object",
      "required": ["validity_states", "severity_states", "vote_weight", "min_valid_votes_per_candidate"],
      "properties": {
        "validity_states": { "type": "array", "items": { "enum": ["accept", "reject", "uncertain", "not_assessed"] } },
        "severity_states": { "type": "array", "items": { "enum": ["blocker", "major", "suggestion"] } },
        "vote_weight": { "type": "integer", "minimum": 1 },
        "weights_are_prompt_only": { "type": "boolean" },
        "severity_is_separate": { "type": "boolean" },
        "severity_gap_for_human": { "type": "integer", "minimum": 1 },
        "not_assessed_is_reject": { "const": false },
        "min_valid_votes_per_candidate": { "type": "integer", "minimum": 1 }
      }
    },
    "conclusion_rules": {
      "type": "object",
      "required": ["auto_pass", "blocker_majority_reject_threshold"],
      "properties": {
        "auto_pass": { "const": false },
        "blocker_majority_reject_threshold": { "type": "integer", "minimum": 1 },
        "chief_reject_requires_human_review": { "type": "boolean" },
        "chief_supplement_blocker_requires_human_review": { "type": "boolean" },
        "chief_downgrade_blocker_requires_human_review": { "type": "boolean" }
      }
    },
    "evidence": {
      "type": "object",
      "required": ["levels", "rules", "claim", "status"],
      "additionalProperties": false,
      "properties": {
        "levels": {
          "type": "object",
          "required": ["E1", "E2", "E3", "E4"],
          "additionalProperties": {
            "type": "object",
            "required": ["types", "strength"],
            "additionalProperties": false,
            "properties": {
              "types": { "type": "array", "minItems": 1, "items": { "type": "string" } },
              "strength": {
                "oneOf": [
                  { "enum": ["strong", "medium", "weak"] },
                  { "type": "array", "minItems": 1, "items": { "enum": ["strong", "medium", "weak"] } }
                ]
              }
            }
          }
        },
        "rules": {
          "type": "object",
          "required": [
            "historical_bug_cannot_prove_current",
            "testing_standard_is_not_business_fact",
            "inference_requires_kb_grounded_false",
            "no_e1_e2_means_no_blocker",
            "same_level_conflict_requires_human",
            "fusion_cannot_raise_strength"
          ],
          "additionalProperties": false,
          "properties": {
            "historical_bug_cannot_prove_current": { "const": true },
            "testing_standard_is_not_business_fact": { "const": true },
            "inference_requires_kb_grounded_false": { "const": true },
            "no_e1_e2_means_no_blocker": { "const": true },
            "same_level_conflict_requires_human": { "const": true },
            "fusion_cannot_raise_strength": { "const": true }
          }
        },
        "claim": {
          "type": "object",
          "required": ["roles", "relations", "allow_empty_core"],
          "additionalProperties": false,
          "properties": {
            "roles": { "type": "array", "minItems": 2, "items": { "enum": ["core", "supporting"] } },
            "relations": { "type": "array", "minItems": 2, "items": { "enum": ["and", "or"] } },
            "allow_empty_core": { "const": false }
          }
        },
        "status": {
          "type": "array",
          "minItems": 5,
          "uniqueItems": true,
          "items": { "enum": ["grounded", "partially_grounded", "ungrounded", "conflicted", "insufficient"] }
        }
      }
    },
    "human_review_triggers": {
      "type": "object",
      "required": [
        "disputed",
        "severity_disputed",
        "evidence_conflict",
        "partially_grounded_blocker",
        "chief_downgrades_blocker",
        "chief_supplements_blocker"
      ],
      "additionalProperties": false,
      "properties": {
        "disputed": { "const": true },
        "severity_disputed": { "const": true },
        "evidence_conflict": { "const": true },
        "partially_grounded_blocker": { "const": true },
        "chief_downgrades_blocker": { "const": true },
        "chief_supplements_blocker": { "const": true }
      }
    },
    "fusion": {
      "type": "object",
      "required": ["step_tolerance", "cosine_suspect", "cosine_high", "rerank_required", "false_merge_target_max"],
      "additionalProperties": false,
      "properties": {
        "step_tolerance": { "type": "integer", "minimum": 0 },
        "cosine_suspect": { "type": "number", "minimum": 0, "maximum": 1 },
        "cosine_high": { "type": "number", "minimum": 0, "maximum": 1 },
        "rerank_required": { "type": "boolean" },
        "false_merge_target_max": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    }
  }
}
