__pycache__/
*.py[cod]
.pytest_cache/

# Python 虚拟环境与测试临时目录
.venv/
.tmp/
.testwork/
pytest-of-*/

# 本地密钥与环境变量
.env

# 附件本机持久化卷（不进 Git，见 docs/06 §1）
