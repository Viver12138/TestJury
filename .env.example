# 服务（docs/06 §2）
# 复制为 .env 后填写；.env 已被 .gitignore 忽略，不要提交
APP_ENV=dev
HOST=127.0.0.1
PORT=8000
WORKER_CONCURRENCY=4
RUN_WORKER=true
JOB_TIMEOUT_SECONDS=1200
MODEL_TIMEOUT_SECONDS=120

# 阶段超时（秒，docs/13 §3）
STAGE_TIMEOUT_PREPROCESS=60
STAGE_TIMEOUT_KB=60
STAGE_TIMEOUT_BLIND=240
STAGE_TIMEOUT_FUSION=30
STAGE_TIMEOUT_VOTE=180
STAGE_TIMEOUT_ARBITRATION=180
STAGE_TIMEOUT_VERDICT=15
STAGE_TIMEOUT_RENDER=30
STAGE_TIMEOUT_DB=10

# 任务队列（PostgreSQL 持久化）
QUEUE_LEASE_SECONDS=300
QUEUE_MAX_ATTEMPTS=3
QUEUE_POLL_INTERVAL_MS=500

# 数据库（必填；缺失则服务拒绝启动，见 ACC-M0-002）
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/review_panel
# 迁移等同步工具使用；未设置时由 DATABASE_URL 推导
# ALEMBIC_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/review_panel

# 存储后端：postgres（默认）| memory（仅单测/本地 Mock 演示；生产禁止）
STORAGE_BACKEND=postgres
# 是否启动内置 Worker（API 与 Worker 也可分进程部署）
RUN_WORKER=true

# 模型与 Prompt 注册表
MODEL_REGISTRY_PATH=./config/models.yaml
PROMPT_REGISTRY_PATH=./config/prompts.yaml
INPUT_MAX_CHARS=20000
ATTACHMENT_DIR=./data/attachments
ATTACHMENT_MAX_MB=20
ATTACHMENT_ALLOWED_MIME=image/png,image/jpeg,application/pdf,text/plain

# 供应商密钥（只放密钥，不放模型 ID 别名）
QWEN_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# 检索参数（M2/M3 使用；M0 只参与版本号计算）
RETRIEVAL_QUERY_MAX=12
RETRIEVAL_TOP_K_KEYWORD=40
RETRIEVAL_TOP_K_VECTOR=40
RETRIEVAL_TOP_N_RERANK=40
RRF_K=60
KB_CONTEXT_TOP_K=10
KB_CONTEXT_TOKEN_CAP=15000
EMBEDDING_PROVIDER=qwen
EMBEDDING_MODEL=qwen3.7-text-embedding-flash
EMBEDDING_MODEL_VERSION=v1
EMBEDDING_DIMENSION=1024
RERANK_PROVIDER=qwen
RERANK_MODEL=qwen3.7-text-rerank
RERANK_TIMEOUT_SECONDS=20

# 融合
FUSION_SIM_THRESHOLD=0.86
FUSION_SUSPECT_THRESHOLD=0.70
STEP_TOLERANCE=1

# 降级与拓扑
MIN_PARTICIPANTS=2
CHIEF_REQUIRED=true
REVIEW_TOPOLOGY=multi
# mock：确定性 Mock（单测/离线）；live：调用 config/models.yaml 的真实模型
REVIEW_MODEL_MODE=mock

# 报告与审批
REPORT_SCHEMA_VERSION=report-1.0
DECISION_REQUIRE_SEPARATION=true
DECISION_MAX_HISTORY=0

# 测试类型边界（docs/00 §6、docs/03 §1）
TEST_TYPE_DEFAULT_POLICY=strict
TEST_TYPE_COMPAT_CALLERS=

# 成本与预算
REVIEW_BUDGET_TOKENS=60000
REVIEW_BUDGET_COST=2.00
BATCH_BUDGET_COST=60.00
DAILY_BUDGET_COST=500.00

# 资源限制
MAX_QUEUE_DEPTH=500
PROVIDER_MAX_CONCURRENCY=4
PROVIDER_RPM_LIMIT=60

# Webhook
WEBHOOK_SECRET=change-me
WEBHOOK_MAX_RETRIES=5
WEBHOOK_TIMEOUT_SECONDS=10

# 版本
KB_CONTENT_DIR=./kb_content
RUBRIC_PATH=./rubric/rubric.yaml
REPORT_SCHEMA_PATH=./schemas/report.schema.json
RETRIEVAL_CONFIG_VERSION=

# 首次启动引导（仅 dev/test）：JSON 数组，格式
# [{"key":"dev-reviewer-key","actor_id":"dev-reviewer","actor_type":"human","roles":["reviewer"]}]
# 生产环境禁止设置；Key 只以 sha256 摘要写入 api_keys 表
BOOTSTRAP_API_KEYS=
