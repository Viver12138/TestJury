{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://testjury.local/schemas/report.schema.json",
  "title": "TestJury Report",
  "type": "object",
  "required": [
    "review_id", "case_id", "status", "stage", "ai_verdict", "human_status",
    "report_schema_version", "issues", "versions"
  ],
  "properties": {
    "review_id": { "type": "string" },
    "case_id": { "type": "string" },
    "case_version": { "type": "integer", "minimum": 1 },
    "test_type": { "enum": ["functional", "performance", "security", "compatibility", "reliability", "usability", "other"] },
    "test_type_source": { "enum": ["request", "compat_default"] },
    "generation": { "type": "integer", "minimum": 1 },
    "parent_review_id": { "type": ["string", "null"] },
    "status": { "enum": ["queued", "processing", "retrying", "done", "completed_with_warnings", "failed", "cancelled"] },
    "stage": { "enum": ["input_check", "preprocess", "kb_retrieve", "blind_review", "fusion", "vote", "arbitration", "verdict", "render"] },
    "ai_verdict": { "enum": ["blocked", "conditional", "need_human", null] },
    "human_status": { "enum": ["pending", "approved", "rejected", "changes_requested"] },
    "degraded": { "type": "boolean" },
    "degraded_reasons": { "type": "array", "items": { "type": "string" } },
    "participants": { "type": "array", "items": { "type": "string" } },
    "topology": { "enum": ["single", "dual", "multi"] },
    "review_participants": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["participant_id", "role_id", "status"],
        "properties": {
          "participant_id": { "type": "string" },
          "role_id": { "type": "string" },
          "status": { "enum": ["active", "failed", "absent"] },
          "model": { "type": ["string", "null"] },
          "actual_model": { "type": ["string", "null"] }
        }
      }
    },
    "review_completeness": {
      "type": "object",
      "properties": {
        "blind": { "type": "string" },
        "vote": { "type": "string" },
        "arbitration": { "type": "string" },
        "arbitration_required": { "type": "boolean" },
        "complete": { "type": "boolean" },
        "full_participation": { "type": "boolean" },
        "stages_completed": { "type": "array", "items": { "type": "string" } },
        "stages_skipped": { "type": "array", "items": { "type": "string" } },
        "stages_failed": { "type": "array", "items": { "type": "string" } },
        "stages_pending": { "type": "array", "items": { "type": "string" } }
      }
    },
    "input_quality": {
      "type": "object",
      "properties": {
        "hard_errors": { "type": "array", "items": { "type": "string" } },
        "soft_issues": { "type": "array", "items": { "type": "string" } }
      }
    },
    "versions": {
      "type": "object",
      "required": ["kb", "rubric", "prompts", "model_config"],
      "properties": {
        "kb": { "type": "string" },
        "kb_content_version": { "type": "string" },
        "kb_build_version": { "type": "string" },
        "rubric": { "type": "string" },
        "prompts": { "type": "object" },
        "retrieval_config": { "type": "string" },
        "embedding_profile": { "type": "string" },
        "model_config": { "type": "string" },
        "models": { "type": "object" }
      }
    },
    "summary": {
      "type": "object",
      "required": ["total_issues", "blocker", "major", "suggestion"],
      "additionalProperties": false,
      "properties": {
        "total_issues": { "type": "integer", "minimum": 0 },
        "blocker": { "type": "integer", "minimum": 0 },
        "major": { "type": "integer", "minimum": 0 },
        "suggestion": { "type": "integer", "minimum": 0 },
        "kb_grounded": { "type": "integer", "minimum": 0 },
        "inferred": { "type": "integer", "minimum": 0 },
        "disputed": { "type": "integer", "minimum": 0 },
        "human_review_required": { "type": "integer", "minimum": 0 }
      }
    },
    "issues": { "type": "array", "items": { "$ref": "#/$defs/issue" } },
    "attachments": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attachment_id", "analyzed_by_ai"],
        "properties": {
          "attachment_id": { "type": "string" },
          "file_name": { "type": "string" },
          "sha256": { "type": "string" },
          "analyzed_by_ai": { "const": false },
          "status": { "enum": ["ready", "deleted"] }
        }
      }
    },
    "human_review_items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["issue_no", "reason"],
        "additionalProperties": false,
        "properties": {
          "issue_no": { "type": "integer", "minimum": 1 },
          "reason": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["blocker", "severity_disputed", "evidence_conflict", "normal"] }
        }
      }
    },
    "kb_gaps": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["module", "function_point", "suspected_rule", "status"],
        "additionalProperties": false,
        "properties": {
          "module": { "type": "string" },
          "function_point": { "type": "string" },
          "suspected_rule": { "type": "string" },
          "gap_type": { "enum": ["knowledge_missing", "retrieval_missed", "knowledge_conflict", "knowledge_outdated"] },
          "occurrences": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["open", "accepted", "dismissed", "merged"] }
        }
      }
    },
    "scope": { "type": "object" },
    "decision_summary": {
      "type": "object",
      "required": ["human_status", "history_count"],
      "additionalProperties": false,
      "properties": {
        "human_status": { "enum": ["pending", "approved", "rejected", "changes_requested"] },
        "latest_decision": { "type": ["string", "null"] },
        "history_count": { "type": "integer", "minimum": 0 }
      }
    },
    "appendix": { "type": "object" },
    "report_schema_version": { "type": "string" },
    "created_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] }
  },
  "$defs": {
    "issue": {
      "type": "object",
      "required": ["issue_no", "dimension", "severity", "category", "rationale", "status"],
      "properties": {
        "issue_no": { "type": "integer", "minimum": 1 },
        "candidate_id": { "type": ["string", "null"] },
        "step_index": { "type": ["integer", "null"] },
        "dimension": { "enum": ["business", "test_design", "automation"] },
        "severity": { "enum": ["blocker", "major", "suggestion"] },
        "category": { "type": "string" },
        "evidence_quote": { "type": ["string", "null"] },
        "rationale": { "type": "string" },
        "suggestion": { "type": ["string", "null"] },
        "evidence_refs": { "type": "array", "items": { "type": "object" } },
        "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "confidence_source": { "enum": ["uncalibrated", "calibrated"] },
        "model_confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "validation_status": { "enum": ["passed", "rejected", "needs_review", null] },
        "evidence_support_status": { "enum": ["supported", "unsupported", "conflicted", "insufficient", null] },
        "decision_status": { "enum": ["accepted", "rejected", "needs_review", null] },
        "kb_grounded": { "type": "boolean" },
        "kb_refs": { "type": "array", "items": { "type": "string" } },
        "evidence_type": { "type": ["string", "null"] },
        "evidence_strength": { "type": ["string", "null"] },
        "evidence_status": { "enum": ["grounded", "partially_grounded", "ungrounded", "conflicted", "insufficient", null] },
        "proposed_by": { "type": "array", "items": { "type": "string" } },
        "votes": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["validity"],
            "additionalProperties": false,
            "properties": {
              "validity": { "enum": ["accept", "reject", "uncertain", "not_assessed"] },
              "severity": { "enum": ["blocker", "major", "suggestion", null] }
            }
          }
        },
        "vote_summary": {
          "type": "object",
          "required": ["support", "reject", "not_assessed", "uncertain"],
          "additionalProperties": false,
          "properties": {
            "support": { "type": "integer", "minimum": 0 },
            "reject": { "type": "integer", "minimum": 0 },
            "not_assessed": { "type": "integer", "minimum": 0 },
            "uncertain": { "type": "integer", "minimum": 0 },
            "support_ratio": { "type": "number", "minimum": 0, "maximum": 1 },
            "severity_distribution": { "type": "object" },
            "severity_disputed": { "type": "boolean" },
            "vote_completeness": { "type": "string" }
          }
        },
        "status": { "enum": ["adopted", "rejected", "disputed", "need_human", "chief_supplement"] },
        "chief_decision": { "type": ["string", "null"] },
        "chief_reason": { "type": ["string", "null"] },
        "human_verdict": { "type": ["string", "null"] }
      }
    }
  }
}
